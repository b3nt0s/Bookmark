# Copy this file to .env (this folder, or the repo root) and fill it in. .env is git-ignored; never commit it.

# Get the key from the team Discord.
GEMINI_API_KEY=

# Port the API listens on (defaults to 8000).
PORT=

# Front end origins allowed to call the API from another origin, comma-separated.
# Not needed when the front end goes through `npm run dev` (it proxies /api) or the backend serves it.
ALLOWED_ORIGINS=

# Google sign-in (from Wen).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
SESSION_SECRET=
